NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
# setup and db:local:init replace this placeholder in ignored .env files.
DATABASE_URL=postgresql://bcis:CHANGE_ME@127.0.0.1:55432/bcis_dev
# Offline restore only. Use a separately managed restore operator credential with
# database creation/rename and session termination rights; never expose it to the API process.
RESTORE_DATABASE_URL=postgresql://bcis_restore:CHANGE_ME@127.0.0.1:55432/postgres
DATABASE_POOL_MAX=10
PAYMENT_PROOF_DIR=.local/payment-proofs
BACKUP_DIR=.local/backups
# Optional when PostgreSQL client tools are not on PATH.
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
# TAR_BIN=tar
# Must name a separate, disposable database ending in _test.
TEST_DATABASE_URL=postgresql://bcis:CHANGE_ME@127.0.0.1:55432/bcis_test
# Required only by `npm run db:seed:demo`; never use this example value unchanged.
DEMO_ACCOUNT_PASSWORD=CHANGE_ME_TO_A_UNIQUE_DEMO_PASSWORD
