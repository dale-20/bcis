{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "electron-vite/node", "vite/client"],
